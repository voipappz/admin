# Phoenix (Elixir) backend, single stage. Pure-BEAM: no Node, no Vite, no
# React anywhere in this image. connectix/ is the whole app — one process
# answers the LiveView UI, /auth and /api (forwarded to the mothership), and
# the /ws/events realtime socket, so the browser needs no second origin and no
# CORS.
#
# Build context is THIS directory (voipappz/app), not connectix/, only because
# that is where this file and Dockerfile.base already live; every COPY below
# reaches into connectix/ for its actual source.

# Declared BEFORE the first FROM on purpose: an ARG written between stages is
# scoped to the stage it follows, so the later `FROM debian:${DEBIAN_VERSION}`
# would expand to an empty version and fail to parse the image reference.
# Declared HERE, above the first FROM, because an ARG used in a `FROM` is only
# visible in the global scope — declared beside the stage that uses it, docker
# reports "base name (${BASE_IMAGE}) should not be blank", and only on a build
# that is not already cached.
ARG BASE_IMAGE=connectix:base
ARG ELIXIR_VERSION=1.19.5
ARG OTP_VERSION=27.3.4
ARG DEBIAN_VERSION=trixie-20260610-slim
# The RUNNER tracks trixie rather than pinning the same dated snapshot as the
# builder. Debian's pool rotates: the snapshot's apt index still named
# libncurses6 6.5+20250216-2, which the mirror now answers 403, so the pinned
# runner could no longer install its own packages. A runner newer than the
# builder is safe (same Debian release, so the same glibc major); older is not.
ARG RUNNER_DEBIAN_VERSION=trixie-slim

# ---------------------------------------------------------------------------
# The Phoenix release.
# ---------------------------------------------------------------------------
# FROM THE BASE, which already carries the toolchain, hex/rebar and — the point
# — `deps.get` and `deps.compile` for this mix.lock. Measured before the split:
# those two were 117.6s of a ~180s cold build, and a kamal builder is always
# cold, so that was paid on every deploy.
#
# The dependency steps below stay rather than being deleted. They are no-ops
# against a matching base (deps and _build are already there), and they are what
# makes the build still CORRECT against a stale or absent one — a base image
# that silently ships yesterday's dependencies is the failure this pattern
# invites, and `make base` checks the lockfile for exactly that reason.
# ---------------------------------------------------------------------------
# The Chrome extension.
# ---------------------------------------------------------------------------
# A SEPARATE STAGE, and that is the whole point: node lives and dies here. The
# final image below copies ONE FILE out of it -- a zip -- and carries no node,
# no npm and no node_modules. "Pure BEAM" is a property of what SHIPS, and it
# still holds.
#
# It is built HERE rather than committed as a binary because a zip in git is a
# thing nobody can review and everybody forgets to rebuild: the extension went
# out stale for a whole release that way. Building it beside the portal it
# talks to means the two cannot drift.
#
# NODE 20, NOT a current one. Angular 11 + webpack 4 need
# --openssl-legacy-provider (already set inside chrome/package.json's scripts)
# and do not build on newer node even with it.
FROM node:20 AS extension
WORKDIR /ext

# Dependencies first, so a source-only change to the extension reuses this
# layer. --legacy-peer-deps: the Angular 11 tree does not satisfy npm 7+ peer
# resolution.
COPY chrome/package.json chrome/package-lock.json ./
RUN npm ci --legacy-peer-deps --no-audit --no-fund

COPY chrome/ ./

# THE VERSION COMES FROM THE APP, not from the extension's own manifest. Both
# artifacts ship from one commit, so "which extension goes with this portal?"
# must not be answerable only by unpacking the zip. mix.exs is the single
# source; scripts/stamp-manifest.mjs writes it into the built manifest.
COPY connectix/mix.exs /tmp/app-mix.exs
RUN EXT_VERSION="$(sed -n 's/^ *version: "\([^"]*\)".*/\1/p' /tmp/app-mix.exs | head -1)"; \
    test -n "$EXT_VERSION" || { echo "could not read version from connectix/mix.exs"; exit 1; }; \
    echo "extension version <- mix.exs: $EXT_VERSION"; \
    EXT_VERSION="$EXT_VERSION" npm run build:production

# A malformed manifest still "builds" -- the failure only shows when Chrome
# refuses to load it, which is after a deploy and in front of a user. Assert
# the fields that make it loadable, here, where it costs nothing.
RUN test -f extension-build.zip && \
    node -e 'const m=require("./angular/dist/manifest.json"); \
      if (m.manifest_version!==3) throw new Error("expected manifest_version 3"); \
      for (const f of ["name","version","action"]) if(!m[f]) throw new Error("manifest missing "+f); \
      if(!m.background||!m.background.service_worker) throw new Error("manifest missing background.service_worker"); \
      console.log("manifest ok:", m.name, m.version)'

# ---------------------------------------------------------------------------
# The Ionic app.
# ---------------------------------------------------------------------------
# A SEPARATE STAGE, for the same reason as the extension above: node lives and
# dies here. The final image copies ONE DIRECTORY of static files out of it and
# carries no node, no npm and no node_modules.
#
# NODE 22, per ionic/.nvmrc. Angular 21 is below neither — it refuses node 20
# at its engines floor, so this is not interchangeable with the extension's
# node:20 stage above.
FROM node:22 AS ionic
WORKDIR /ionic

# Dependencies first, so a source-only change reuses this layer.
# --legacy-peer-deps: the tree does not satisfy npm 7+ peer resolution
# (@angular-eslint 19 against Angular 21, protractor against current rxjs).
COPY ionic/package.json ionic/package-lock.json ./
RUN npm ci --legacy-peer-deps --no-audit --no-fund

COPY ionic/ ./

# --base-href /app/ IS NOT OPTIONAL. index.html references every asset
# relatively (`assets/config/main.js`, the hashed bundles), so built at / and
# served at /app every one of them 404s — a build that compiles perfectly and
# renders a blank page, which only shows in front of a user.
RUN npx ng build --configuration=production --base-href /app/

# Plug.Static's `gzip: true` serves `foo.js.gz` IF IT EXISTS, and it is
# `mix phx.digest` that normally writes those. This bundle deliberately lives
# outside priv/static so digest never sees it — so the .gz files are made here
# or not at all, and without them the option silently does nothing and every
# phone downloads the uncompressed bundle. -k keeps the original: Plug.Static
# needs both, and falls back to the plain file for a client that sent no
# accept-encoding.
RUN find www -type f \( -name '*.js' -o -name '*.css' -o -name '*.html' \
      -o -name '*.json' -o -name '*.svg' \) -exec gzip -9 -k -f {} + \
    && echo "compressed $(find www -name '*.gz' | wc -l) files"

# THE SAME ASSERTIONS `make -C ionic check` runs, here where a broken build
# cannot reach a deploy. A wrong base href and a stale index.html naming a
# chunk the build no longer emits are both silent: the image builds, the node
# boots, /app answers 200, and the page is blank.
RUN set -eu; \
    test -f www/index.html || { echo "no www/index.html — the build produced nothing"; exit 1; }; \
    grep -q '<base href="/app/"' www/index.html \
      || { echo "index.html has no <base href=\"/app/\"> — every asset would 404"; exit 1; }; \
    main=$(grep -oE 'src="main[^"]*\.js"' www/index.html | head -1 | sed 's/src="//;s/"//'); \
    test -n "$main" || { echo "index.html names no main bundle"; exit 1; }; \
    test -f "www/$main" || { echo "index.html names www/$main, absent from the build"; exit 1; }; \
    echo "ionic ok: $main"

FROM ${BASE_IMAGE} AS builder

WORKDIR /app

ENV MIX_ENV="prod"

# Dependencies first, so a source-only change does not re-fetch or re-compile
# them. Paths are prefixed with connectix/ because the context is one level up.
# Hex's own advice for a constrained network, and it is needed here: the
# default fans out parallel fetches with a short timeout, and on a link that
# stalls mid-transfer that surfaces as `Request failed (:timeout)` on a
# different package every run — indistinguishable from a bad lock entry. One
# connection with a long timeout is slower and finishes.
ENV HEX_HTTP_CONCURRENCY=1
ENV HEX_HTTP_TIMEOUT=120

COPY connectix/mix.exs connectix/mix.lock ./
RUN mix deps.get --only $MIX_ENV
RUN mkdir -p config

COPY connectix/config/config.exs connectix/config/${MIX_ENV}.exs config/

# THE PARROT PATCHES, BEFORE parrot IS COMPILED. `priv/` is copied further
# down, after `deps.compile` — so until now the production image built parrot
# PRISTINE while every developer ran a patched one. The four source fixes real
# SIP interop depends on (stacked-Via received/rport, inbound INVITE using
# transaction.request, Transaction implementing Access, and the mono capture)
# were simply absent from what shipped, and nothing said so: the image builds,
# boots and answers /health exactly the same either way.
COPY connectix/priv/parrot_patches priv/parrot_patches
RUN bash priv/parrot_patches/apply.sh

RUN mix deps.compile

RUN mix assets.setup

COPY connectix/priv priv
COPY connectix/lib lib

# The extension, into the release. priv/extension/ and NOT priv/static/: this
# is served by ReleaseController, not by Plug.Static, so it needs no entry in
# `static_paths()` and `mix phx.digest` leaves it alone -- a digested zip under
# a content-hashed name is a file no install instruction can name.
COPY --from=extension /ext/extension-build.zip priv/extension/voipappz-extension.zip

# The Ionic app, into the release. priv/app/ and NOT priv/static/app/ for a
# neighbouring reason: `mix phx.digest` (run by `mix assets.deploy` below)
# walks ALL of priv/static whatever `static_paths()` says, so a bundle there
# gets a second content-hashed copy of every Angular chunk and a
# cache_manifest entry -- for nothing, because Angular already hashes its own
# filenames. Here, digest never sees it and the copy can sit before or after
# `assets.deploy` without the order mattering. Served by its own `Plug.Static`
# declaration in the endpoint, at /app.
COPY --from=ionic /ionic/www priv/app

# WHICH BUILD, as opposed to which version. mix.exs is bumped deliberately and
# therefore rarely: two deploys a week apart are both "0.1.0", so the version
# alone cannot answer "is this node running what I just pushed?" -- and the
# post-deploy version check passes either way, which makes it feel more
# informative than it is.
#
# The sha is written to a FILE rather than compiled in, so it costs no
# recompilation and an image can be inspected without booting it. `unknown` is
# the honest answer for a `docker build` run by hand, not a failure.
ARG RELEASE_SHA=unknown
RUN echo "${RELEASE_SHA}" > priv/extension/build-sha

RUN mix compile

COPY connectix/assets assets
RUN mix assets.deploy

# Changes here don't require recompiling the code.
COPY connectix/config/runtime.exs config/

COPY connectix/rel rel
RUN mix release

# Slim the release before it is copied into the runtime image.
#
# Two things make it 1.4GB, and neither is code we wrote:
#
#   * Precompiled FFmpeg ships as REAL FILES at every soname — `libavcodec.so`,
#     `.so.60` and `.so.60.3.100` are three identical 71MB copies, not the
#     symlinks a distribution would use — and bundlex keeps its own second copy
#     of the whole set under `priv/shared/precompiled`. libavcodec alone
#     accounted for six copies, ~426MB.
#   * The precompiled NIFs arrive unstripped: mdex_native 146MB, lumis 141MB,
#     duckdb 49MB, almost all of it debug symbols nothing in production reads.
#
# Deduplicating with HARD LINKS rather than deleting keeps every path valid —
# a NIF's RPATH, a soname lookup, anything that expects a file where it found
# one — while the layer stores the content once. `strip --strip-unneeded`
# keeps the dynamic symbol table, which is what dlopen and the NIF entry point
# need; only debug and local symbols go.
RUN set -eu; \
    rel="/app/_build/${MIX_ENV}/rel/connectix"; \
    before=$(du -sm "$rel" | cut -f1); \
    find "$rel" -type f -name '*.so*' -exec strip --strip-unneeded {} + 2>/dev/null || true; \
    find "$rel" -type f -size +1M -exec sha256sum {} + \
      | sort \
      | awk '{ h = substr($0, 1, 64); f = substr($0, 67); \
               if (h == prev) { print prevfile; print f } else { prev = h; prevfile = f } }' \
      | while read -r keep && read -r dup; do \
          [ "$keep" = "$dup" ] || ln -f "$keep" "$dup"; \
        done; \
    after=$(du -sm "$rel" | cut -f1); \
    echo "release slimmed: ${before}MB -> ${after}MB"

# ---------------------------------------------------------------------------
# Final: the release, standalone.
# ---------------------------------------------------------------------------
FROM docker.io/hexpm/erlang:${OTP_VERSION}-debian-${DEBIAN_VERSION} AS final

# No apt in this stage, deliberately. The runner is Erlang's own Debian image,
# which already carries what a release needs at runtime — libstdc++, ncurses,
# openssl and ca-certificates (the last matters: Req calls the mothership over
# https, and without CA certs that fails at TLS verification, not at DNS).
#
# Installing them instead made the build depend on reaching deb.debian.org,
# which answers 403 from this network often enough to fail a build at a
# different random package each time. Nothing here needs a package manager, so
# the dependency is removed rather than retried.
#
# C.UTF-8 is built into glibc, so it needs no `locales` package or locale-gen.
ENV LANG=C.UTF-8
ENV LC_ALL=C.UTF-8

WORKDIR "/app"
RUN chown nobody /app

# THE DATA DIRECTORY, OWNED BY THE USER THAT RUNS. The release runs as
# `nobody` and every destination mounts a volume at /data for Mnesia and the
# DuckDB event store. A named volume inherits ownership from the image the
# FIRST time it is populated — so creating and chowning it here is what makes
# a fresh host work.
#
# Without it the app boots, reaches Connectix.Portal.Store, and dies on
# `File.mkdir_p!("/data/mnesia")` with :eacces — which reads as a code bug
# rather than a mount owned by root.
#
# An ALREADY-EXISTING volume keeps its old ownership and this cannot fix it:
#   docker run --rm -v <volume>:/data alpine chown -R 65534:0 /data
RUN mkdir -p /data/mnesia /data/events && chown -R nobody:root /data

ENV MIX_ENV="prod"

COPY --from=builder --chown=nobody:root /app/_build/${MIX_ENV}/rel/connectix ./

USER nobody

CMD ["/app/bin/server"]
