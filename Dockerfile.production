# Phoenix (Elixir) backend, single stage. Pure-BEAM: no Node, no Vite, no
# React anywhere in this image. connectix/ is the whole app — one process
# answers the LiveView UI, /auth and /api (forwarded to the mothership), and
# the /ws/events realtime socket, so the browser needs no second origin and no
# CORS.
#
# Build context is THIS directory (voipappz/app), not connectix/, only because
# that is where this file and Dockerfile.base already live; every COPY below
# reaches into connectix/ for its actual source.

# Declared BEFORE the first FROM on purpose: an ARG written between stages is
# scoped to the stage it follows, so the later `FROM debian:${DEBIAN_VERSION}`
# would expand to an empty version and fail to parse the image reference.
# Declared HERE, above the first FROM, because an ARG used in a `FROM` is only
# visible in the global scope — declared beside the stage that uses it, docker
# reports "base name (${BASE_IMAGE}) should not be blank", and only on a build
# that is not already cached.
ARG BASE_IMAGE=connectix:base
ARG ELIXIR_VERSION=1.19.5
ARG OTP_VERSION=27.3.4
ARG DEBIAN_VERSION=trixie-20260610-slim
# The RUNNER tracks trixie rather than pinning the same dated snapshot as the
# builder. Debian's pool rotates: the snapshot's apt index still named
# libncurses6 6.5+20250216-2, which the mirror now answers 403, so the pinned
# runner could no longer install its own packages. A runner newer than the
# builder is safe (same Debian release, so the same glibc major); older is not.
ARG RUNNER_DEBIAN_VERSION=trixie-slim

# ---------------------------------------------------------------------------
# The Phoenix release.
# ---------------------------------------------------------------------------
# FROM THE BASE, which already carries the toolchain, hex/rebar and — the point
# — `deps.get` and `deps.compile` for this mix.lock. Measured before the split:
# those two were 117.6s of a ~180s cold build, and a kamal builder is always
# cold, so that was paid on every deploy.
#
# The dependency steps below stay rather than being deleted. They are no-ops
# against a matching base (deps and _build are already there), and they are what
# makes the build still CORRECT against a stale or absent one — a base image
# that silently ships yesterday's dependencies is the failure this pattern
# invites, and `make base` checks the lockfile for exactly that reason.
FROM ${BASE_IMAGE} AS builder

WORKDIR /app

ENV MIX_ENV="prod"

# Dependencies first, so a source-only change does not re-fetch or re-compile
# them. Paths are prefixed with connectix/ because the context is one level up.
# Hex's own advice for a constrained network, and it is needed here: the
# default fans out parallel fetches with a short timeout, and on a link that
# stalls mid-transfer that surfaces as `Request failed (:timeout)` on a
# different package every run — indistinguishable from a bad lock entry. One
# connection with a long timeout is slower and finishes.
ENV HEX_HTTP_CONCURRENCY=1
ENV HEX_HTTP_TIMEOUT=120

COPY connectix/mix.exs connectix/mix.lock ./
RUN mix deps.get --only $MIX_ENV
RUN mkdir -p config

COPY connectix/config/config.exs connectix/config/${MIX_ENV}.exs config/

# THE PARROT PATCHES, BEFORE parrot IS COMPILED. `priv/` is copied further
# down, after `deps.compile` — so until now the production image built parrot
# PRISTINE while every developer ran a patched one. The four source fixes real
# SIP interop depends on (stacked-Via received/rport, inbound INVITE using
# transaction.request, Transaction implementing Access, and the mono capture)
# were simply absent from what shipped, and nothing said so: the image builds,
# boots and answers /health exactly the same either way.
COPY connectix/priv/parrot_patches priv/parrot_patches
RUN bash priv/parrot_patches/apply.sh

RUN mix deps.compile

RUN mix assets.setup

COPY connectix/priv priv
COPY connectix/lib lib

RUN mix compile

COPY connectix/assets assets
RUN mix assets.deploy

# Changes here don't require recompiling the code.
COPY connectix/config/runtime.exs config/

COPY connectix/rel rel
RUN mix release

# ---------------------------------------------------------------------------
# Final: the release, standalone.
# ---------------------------------------------------------------------------
FROM docker.io/hexpm/erlang:${OTP_VERSION}-debian-${DEBIAN_VERSION} AS final

# No apt in this stage, deliberately. The runner is Erlang's own Debian image,
# which already carries what a release needs at runtime — libstdc++, ncurses,
# openssl and ca-certificates (the last matters: Req calls the mothership over
# https, and without CA certs that fails at TLS verification, not at DNS).
#
# Installing them instead made the build depend on reaching deb.debian.org,
# which answers 403 from this network often enough to fail a build at a
# different random package each time. Nothing here needs a package manager, so
# the dependency is removed rather than retried.
#
# C.UTF-8 is built into glibc, so it needs no `locales` package or locale-gen.
ENV LANG=C.UTF-8
ENV LC_ALL=C.UTF-8

WORKDIR "/app"
RUN chown nobody /app

ENV MIX_ENV="prod"

COPY --from=builder --chown=nobody:root /app/_build/${MIX_ENV}/rel/connectix ./

USER nobody

CMD ["/app/bin/server"]
