# Multistage build: React frontend + Deno backend in a single image.
# Stage 1 builds the React bundle. Stage 2 runs Deno, which both serves the
# built assets from /app/dist and dispatches API routes under /apps/*.

# Stage 1: Build React app
FROM node:26-alpine AS frontend-builder
WORKDIR /build

ARG VITE_SUPABASE_URL
ARG VITE_SUPABASE_ANON_KEY
ARG VITE_SUPABASE_PUBLISHABLE_DEFAULT_KEY
ARG VITE_APP_VERSION
ENV VITE_SUPABASE_URL=$VITE_SUPABASE_URL
ENV VITE_SUPABASE_ANON_KEY=$VITE_SUPABASE_ANON_KEY
ENV VITE_SUPABASE_PUBLISHABLE_DEFAULT_KEY=$VITE_SUPABASE_PUBLISHABLE_DEFAULT_KEY
ENV VITE_APP_VERSION=$VITE_APP_VERSION

COPY package.json package-lock.json ./
RUN npm ci

COPY . .
RUN npm run build

# Stage 2: Deno runtime serving React + API
FROM denoland/deno:2.9.6
WORKDIR /app

COPY api/deno.json api/deno.lock ./
COPY api/*.ts ./
COPY api/pdf/ ./pdf/
COPY api/pdf-service/ ./pdf-service/
RUN deno cache supabase.ts pdf-service/server.ts

COPY --from=frontend-builder /build/dist ./dist

ENV STATIC_DIR=/app/dist
ENV PORT=3000
EXPOSE 3000

# Healthcheck handled by kamal-proxy (proxy.healthcheck.path: /test in
# config/deploy.yml). Avoiding a Dockerfile HEALTHCHECK because Deno 2.5's
# `deno eval` does not accept --allow-* flags.

USER deno

CMD ["deno", "run", "--allow-net", "--allow-env", "--allow-read", "supabase.ts"]
