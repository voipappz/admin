# Git
.git
.gitignore

# Environment files (may contain secrets)
.env
.env.local
.env.*.local
.env.local.example

# IDE and editor
.vscode/
.idea/
*.swp
*.swo

# Documentation (may contain sensitive examples)
*.md
!README.md

# Old/backup files
OLD/
*.bak
*.old

# Claude/AI assistant files
.claude/

# Logs
*.log
logs/

# OS files
.DS_Store
Thumbs.db

# Docker files (not needed inside container)
Dockerfile*
docker-compose*.yml
.dockerignore

# CI/CD configs (contain secrets)
.circleci/

# Elixir build artifacts (connectix). The Dockerfile copies only sources and
# compiles inside the image, so shipping these in the build context costs
# hundreds of MB of transfer per build and buys nothing — and a host-built
# _build/ carries binaries for the wrong architecture.
connectix/_build
connectix/deps
connectix/.elixir_ls
connectix/priv/static/assets
connectix/erl_crash.dump

# The Chrome extension: its build output and its own node tree. The BEAM
# image has no Node stage and never copies chrome/, but a 650MB node_modules
# in the build context is paid on every deploy regardless.
chrome/node_modules
chrome/angular/dist
chrome/extension-build.zip
chrome/test-results
chrome/playwright-report
