{
  "name": "voipappz-app",
  "version": "0.0.0",
  "description": "VoipAppz App",
  "author": "Ionic Team <hi@ionicframework.com>",
  "license": "Apache-2.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --port 8100",
    "build": "ng build",
    "test": "ng test",
    "test:unit": "ng test --watch=false --browsers=ChromeHeadless",
    "test:unit:ci": "ng test --watch=false --browsers=ChromeHeadlessCI",
    "build:mobile": "ng build --configuration=production && cap sync",
    "assets": "capacitor-assets generate --iconBackgroundColor '#ffffff' --iconBackgroundColorDark '#1c1c1e' --splashBackgroundColor '#ffffff' --splashBackgroundColorDark '#1c1c1e'",
    "lint": "ng lint",
    "e2e": "npx webdriver-manager update --standalone false --gecko false --versions.chrome=99.0.4844.83 && ng e2e --no-webdriver-update",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:chromium": "playwright test --project=chromium",
    "test:e2e:ci": "playwright test smoke.spec.ts responsive.spec.ts login.spec.ts --project=chromium",
    "test:e2e:ci:full": "playwright test smoke.spec.ts responsive.spec.ts login.spec.ts",
    "test:e2e:mobile": "playwright test --project=mobile-chrome --project=mobile-safari",
    "test:e2e:tablet": "playwright test --project=tablet",
    "test:e2e:all": "playwright test --project=chromium --project=mobile-chrome --project=mobile-safari --project=tablet",
    "test:e2e:report": "playwright show-report"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ionic-team/ionic-conference-app.git"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^21.0.8",
    "@angular/core": "^21.0.8",
    "@angular/forms": "^21.0.8",
    "@angular/platform-browser": "^21.0.8",
    "@angular/platform-browser-dynamic": "^21.0.8",
    "@angular/router": "^21.0.8",
    "@angular/service-worker": "^21.0.8",
    "@auth0/angular-jwt": "5.1.0",
    "@capacitor/android": "^6.2.1",
    "@capacitor/app": "^6.0.3",
    "@capacitor/browser": "^6.0.6",
    "@capacitor/core": "^6.2.1",
    "@capacitor/device": "^6.0.3",
    "@capacitor/haptics": "^6.0.3",
    "@capacitor/ios": "^6.2.1",
    "@capacitor/keyboard": "^6.0.4",
    "@capacitor/splash-screen": "^6.0.4",
    "@capacitor/status-bar": "^6.0.3",
    "@ionic/angular": "^8.7.16",
    "@ionic/storage": "^2.1.3",
    "@ionic/storage-angular": "^4.0.0",
    "@ngrx/component-store": "^21.0.1",
    "@ngx-translate/core": "^15.0.0",
    "@ngx-translate/http-loader": "^8.0.0",
    "phoenix": "^1.7.14",
    "cordova-plugin-inappbrowser": "5.0.0",
    "core-js": "^3.6.4",
    "janus-angular": "^0.1.6",
    "janus-gateway-js": "^2.0.2",
    "janus-gateway-tsdx": "^0.3.2",
    "moment": "^2.29.4",
    "ng2-ui-auth": "^10.0.1",
    "rxjs": "^7.8.2",
    "sip.js": "^0.21.2",
    "sw-toolbox": "3.6.0",
    "swiper": "^11.2.10",
    "tslib": "^2.0.0",
    "webdriver-manager": "^12.1.8",
    "webrtc-adapter": "^8.1.2",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/architect": "^0.2100.5",
    "@angular-devkit/build-angular": "^21.0.5",
    "@angular-devkit/core": "^21.0.5",
    "@angular-devkit/schematics": "^21.0.5",
    "@angular-eslint/builder": "^19.8.1",
    "@angular-eslint/eslint-plugin": "^19.8.1",
    "@angular-eslint/eslint-plugin-template": "^19.8.1",
    "@angular-eslint/schematics": "^19.8.1",
    "@angular-eslint/template-parser": "^19.8.1",
    "@angular/cli": "^21.0.5",
    "@angular/compiler": "^21.0.8",
    "@angular/compiler-cli": "^21.0.8",
    "@angular/language-service": "^21.0.8",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^6.2.1",
    "@ionic/angular-toolkit": "^11.0.1",
    "@ionic/cli": "^6.19.0",
    "@ionic/lab": "^2.0.19",
    "@playwright/test": "^1.57.0",
    "@types/jasmine": "~3.6.0",
    "@types/jasminewd2": "2.0.8",
    "@types/node": "^12.20.55",
    "@types/phoenix": "^1.6.5",
    "@typescript-eslint/eslint-plugin": "5.3.0",
    "@typescript-eslint/parser": "5.3.0",
    "eslint": "^8.1.0",
    "jasmine-core": "~3.8.0",
    "jasmine-spec-reporter": "~5.0.0",
    "karma": "~6.3.7",
    "karma-chrome-launcher": "~3.1.0",
    "karma-coverage-istanbul-reporter": "~3.0.2",
    "karma-jasmine": "~4.0.0",
    "karma-jasmine-html-reporter": "^1.5.0",
    "memfs": "^3.6.0",
    "protractor": "~7.0.0",
    "puppeteer": "^11.0.0",
    "ts-node": "8.5.0",
    "tslint": "~6.1.0",
    "typescript": "~5.9.3"
  }
}
