# ============================================================================
#  VoIPAppz portal — environment
#  Copy to `.env` and fill in:   cp .env.example .env   (or: make env)
#  A tenant fork changes ENV, not code.
#
#  Who reads what:
#   - React frontend → only VITE_* vars (baked into the browser bundle).
#   - Elixir portal  → the non-VITE_ vars (agents_demo/config/runtime.exs).
#                      NEVER prefix a secret with VITE_ — it would leak into
#                      the public bundle.
# ============================================================================

# ── Production fallback: which mothership this tenant talks to ──────────────
# Used by the local production Compose profile when ENGINE_URL is unset.
# Unprefixed on purpose: it must never reach the browser bundle. The browser
# always uses RELATIVE URLs and reaches the API through the Elixir portal.
MOTHERSHIP_URL=https://cloud.voipappz.io

# Everything below is OPTIONAL — the app runs with just the line above.

# ── Mothership path overrides (defaults shown; set only if a tenant differs) ─
# VITE_MOTHERSHIP_LOGIN_PATH=/auth/user_login          # step 1: credentials
# VITE_MOTHERSHIP_OTP_PATH=/auth/user/otp/verify       # step 2: OTP code
# VITE_MOTHERSHIP_LOGOUT_PATH=/auth/logout             # sign-out: revokes the token
# VITE_PORTAL_DATA_PATH=/tasks/customer_portal_data    # public branding

# ── Escape hatches (leave unset unless you know you need them) ──────────────
# VITE_MOTHERSHIP_URL — DIRECT mode: the browser calls the mothership
#   cross-origin, bypassing the app server. Only for static-only hosting with
#   no proxy in front (e.g. the Fireberry embed). Setting it can trip CORS.
# PORTAL_ENGINE_URL=http://127.0.0.1:5000      # local portal → local API
# CABLE_API_URL=http://127.0.0.1:5000          # local cable → the same API
# ENGINE_URL — production portal override when MOTHERSHIP_URL is not the engine.
# VITE_PORTAL_TARGET=http://localhost:4001     # Vite → portal when not localhost
# Do NOT set VITE_API_BASE_URL in dev — it bypasses the Vite proxy and trips CORS.

# ── Softphone (WebRTC / SIP) ────────────────────────────────────────────────
# The softphone is configured from the LOGGED-IN USER OBJECT the mothership
# returns (extension.{username,password} + environment.{domain,wss_server}) —
# no endpoint is baked into the code. These are dev/demo overrides only; with
# neither env nor user data the softphone stays unconfigured.
# VITE_SIP_WSS_URL=wss://sbc.example.com:8443
# VITE_SIP_DOMAIN=tenant.example.com
# VITE_SIP_USERNAME=
# VITE_SIP_PASSWORD=
# VITE_SIP_AUTOCONNECT=false
# VITE_SIP_STUN=stun:stun.l.google.com:19302   # the default (vendor-neutral)
# VITE_SIP_TURN_URLS=
# VITE_SIP_TURN_USERNAME=
# VITE_SIP_TURN_CREDENTIAL=
# VITE_SIP_REGISTER_EXPIRES=600   # seconds between REGISTER refreshes (the default)

# ── The portal (agents_demo, :4001) ─────────────────────────────────────────
# The core app (login, calls, reports, features) needs NONE of these — the
# portal forwards those routes to the mothership. These configure the two
# platform transports it uses beyond that; unset, the realtime surfaces simply
# stay quiet and token verification refuses every connection.
#
# The ASK path: token verification is a NATS request/reply to the API. The
# portal never verifies a credential it did not have to ask about, and never
# reaches the API over HTTP for it.
# NATS_URL=nats://default:<password>@nats:4222
#
# The LISTEN path: one application cable connection plus per-user streams.
# CABLE_URL=ws://tenant.example:4000/cable
# CABLE_SECRET_KEY=                           # else SECRET_KEY; mints the cable
#                                             # credential instead of forwarding
#                                             # the browser's token
# CABLE_TOKEN=                                # userless server-side tap only
# CABLE_ACCOUNT_UUID=                         # identifies the app connection allowed
#                                             # to subscribe to node-wide CallEvents
#
# Log shipping: the portal's log lines go to InfluxDB 3 as well as stdout —
# stdout stays exactly as it is (Kamal reads it), Influx is for querying.
# The SAME names va-crystal's node reads, so one .env configures both. The
# token is the switch: unset, no handler is installed and nothing is posted.
# Best effort — an unreachable InfluxDB is one warning at boot, never a crash.
# VA_MONITOR_TOKEN=                           # bearer; unset = log shipping off
# VA_INFLUXDB_HOST=influxdb                   # 127.0.0.1 from a host-network container
# VA_INFLUXDB_PORT=8181
# VA_INFLUXDB_DATABASE=telegraf
#
# Postgres, for the portal's own tables.
# PGHOST=localhost
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=postgres
# DATABASE_URL=                               # production; replaces the PG* set
# SECRET_KEY_BASE=                            # production; `mix phx.gen.secret`

# ── Cosmetics & dev toggles (all optional) ──────────────────────────────────
# VITE_APP_NAME=voipappz                      # tab title / header (else portal data)
# VITE_PRIMARY_COLOR=#00ADB4                  # brand colour (else portal data)
# VITE_APP_VERSION=dev                        # footer version label
# VITE_MOCK_LOGIN=1                           # offline login: any email → OTP below
# VITE_MOCK_OTP_CODE=123456                   # code the mock login accepts
# VITE_USE_MOCK=1                             # seed mock calls when the API is unreachable

# ── Deploy / ops ────────────────────────────────────────────────────────────
# PROD_URL=https://your-host                  # `make status` health probe target

# ── Tests (Playwright) ──────────────────────────────────────────────────────
# PLAYWRIGHT_BASE_URL=http://localhost:4200   # app URL the suite drives (default local)
