#!/bin/sh
# The node is `connectix@127.0.0.1` unless the environment says otherwise:
# `make iex` and the cockpit (`make tui YAML=…`) attach to it by that name.
# The release script's own default is a short name on the container's
# hostname, which nothing can address.
export RELEASE_DISTRIBUTION="${RELEASE_DISTRIBUTION:-name}"
export RELEASE_NODE="${RELEASE_NODE:-connectix@127.0.0.1}"
