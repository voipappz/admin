# ─── Secrets (NEVER commit) ───
.env
.env.local
.env.*.local
.mcp.env
__pycache__/
*.py[cod]
.kamal/secrets
.kamal/secrets.*
!.kamal/secrets.example
.mcp.json

# ─── Dependencies ───
api/data/

# ─── Dead React/Node leftovers ───
# Nothing in this repo produces these any more — the SPA, Vite and the whole
# Node toolchain were deleted when the app became pure BEAM. They survive only
# as root-owned directories Docker created before that, and `rm` cannot remove
# them without sudo. Ignored so a broad `git add` cannot sweep 384MB of dead
# node_modules into a commit while they wait to be deleted by hand.
node_modules/
dist/
test-results/

# ─── Logs ───
*.log

# ─── Editor / OS ───
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
*~

# ─── Local volumes / certs ───
volume/
certs/

# ─── Misc ───
*.tmp
*.pid
backups/

# ─── Captured call data (real events — never commit) ───
api/mock/captured_calls.json

# Kamal destination secrets (registry PAT etc.) — never commit
.kamal/secrets-common
.kamal/secrets.*

# TLS material for destinations that cannot use ACME. nimbus runs behind Kong,
# which owns port 80, so Let's Encrypt's HTTP-01 challenge is unavailable there
# and the certificate is passed to kamal-proxy as PEM secrets instead. The
# private key must never be committed; the cert is ignored with it so the pair
# cannot drift.
.kamal/*.key
.kamal/*.pem

# Agent worktrees — isolated checkouts, never part of the tree
.claude/worktrees/

# ─── Mnesia (the portal's own store) ───
# Runtime DATA, not source: schema.DAT and the .DCD/.DCL logs are written on
# every boot and every write. Committing them means a checkout inherits another
# machine's dashboards, and the schema is bound to the node name that made it.
connectix/priv/mnesia/
.env.bak

# Mnesia leaves a schema directory beside the app even RAM-only, named for the
# node. Nothing in it survives a restart by design — see Connectix.Mnesia.
Mnesia.*
